<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_bridge_node</name>
  <version>0.0.1</version>
  <description>
    Prototype bridge that forwards a single ROS2 topic to/from a Corelink
    stream, for cross-network (robot &lt;-&gt; server) ROS2 communication while
    keeping DDS untouched on both sides.
  </description>
  <maintainer email="bhu7035@gmail.com">syttpz</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>compressed_depth_image_transport</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
